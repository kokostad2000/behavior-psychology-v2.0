# Choose exactly one provider key. DeepSeek has the highest default priority.
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# Optional provider/model overrides.
# BEHAVIOR_PSYCHOLOGY_PROVIDER=deepseek
# BEHAVIOR_PSYCHOLOGY_MODEL=deepseek-flash
# BEHAVIOR_PSYCHOLOGY_BASE_URL=https://api.deepseek.com
# BEHAVIOR_PSYCHOLOGY_TIMEOUT_SECONDS=30
# BEHAVIOR_PSYCHOLOGY_MAX_RETRIES=2

# Optional private profile directory. Profiles are never saved unless
# persist_profile=true / --save-profile is explicitly supplied.
# BEHAVIOR_PSYCHOLOGY_DATA_DIR=/absolute/private/path
