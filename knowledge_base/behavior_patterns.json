{
  "version": "2.1",
  "description": "可观察行为标签词表。标签只复述输入中的行为形式，不编码人格、疾病、意图、关系价值或心理机制。",
  "patterns": [
    {
      "behavior": "被指出错误后以攻击性言语回应",
      "tags": ["hostile_reply_after_criticism", "raised_conflict_intensity", "counterattack"],
      "context_hints": ["被批评", "被指出错误", "被质疑"]
    },
    {
      "behavior": "反复强调自己的资历或成就",
      "tags": ["repeated_credential_reference", "repeated_achievement_reference", "authority_claim"],
      "context_hints": ["被质疑", "竞争环境", "新环境"]
    },
    {
      "behavior": "打断别人说话",
      "tags": ["conversation_interruption", "turn_taking_overlap", "rapid_response"],
      "context_hints": ["争论", "会议", "紧张场合"]
    },
    {
      "behavior": "反复解释同一件事",
      "tags": ["repeated_explanation", "message_repetition", "clarification_request"],
      "context_hints": ["被质疑", "需要澄清", "信息不一致"]
    },
    {
      "behavior": "没有回答问题或转移话题",
      "tags": ["question_nonresponse", "topic_shift", "conversation_redirection"],
      "context_hints": ["冲突", "压力", "敏感话题"]
    },
    {
      "behavior": "未回复或延迟回复消息",
      "tags": ["message_nonresponse", "delayed_response", "reduced_contact"],
      "context_hints": ["日常", "冲突后", "忙碌期"]
    },
    {
      "behavior": "在多次互动中反复道歉",
      "tags": ["repeated_apology", "apology_frequency_increase", "post_error_reassurance_request"],
      "context_hints": ["失误后", "日常互动", "新关系"]
    },
    {
      "behavior": "互动频率下降或回复变短",
      "tags": ["reduced_contact", "shorter_replies", "interaction_change"],
      "context_hints": ["冲突后", "工作繁忙", "关系变化"]
    },
    {
      "behavior": "在关系早期快速分享大量个人信息",
      "tags": ["rapid_self_disclosure", "high_detail_disclosure", "personal_information_sharing"],
      "context_hints": ["新关系", "长时间对话", "寻求支持"]
    },
    {
      "behavior": "在多人互动中通常较晚回复",
      "tags": ["delayed_response", "asynchronous_communication", "late_turn_response"],
      "context_hints": ["日常聊天", "群聊", "工作沟通"]
    },
    {
      "behavior": "在群聊中停止或减少发言",
      "tags": ["reduced_participation", "group_silence", "participation_change"],
      "context_hints": ["争论", "话题转换", "新人加入"]
    },
    {
      "behavior": "频繁询问对方正在做什么",
      "tags": ["frequent_check_in", "repeated_status_question", "contact_frequency_increase"],
      "context_hints": ["亲密关系", "友谊", "异地"]
    },
    {
      "behavior": "对较小触发事件出现强烈情绪表达",
      "tags": ["intense_emotional_response", "raised_voice_or_crying", "rapid_emotional_escalation"],
      "context_hints": ["长期压力", "疲惫", "累积冲突"]
    },
    {
      "behavior": "反复回答“随便”或把选择交给对方",
      "tags": ["preference_nonexpression", "decision_delegation", "repeated_neutral_answer"],
      "context_hints": ["日常决策", "关系互动", "疲惫期"]
    },
    {
      "behavior": "对他人的成功没有明显积极回应",
      "tags": ["limited_positive_response", "response_delay", "topic_shift_after_good_news"],
      "context_hints": ["同事", "朋友", "相似背景"]
    }
  ]
}
